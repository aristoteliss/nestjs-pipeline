# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# Runtime
node_modules/
dist/
build/
.cache/
.tmp/
api/src/persistence/*.db
api/src/persistence/*.db-*
api/src/persistence/migrations/.snapshot*

# Documentation site: Astro's cache, and the pages generated from CHANGELOG.md and the JSDoc
docs/.astro/
docs/src/content/docs/changelog.md
docs/src/content/docs/api/

# Coverage
coverage/
*.lcov

# Environment
.env
.env.local
.env.*.local

# OS
.DS_Store
Thumbs.db

# TypeScript
*.tsbuildinfo

# Generated only during package tarball creation
packages/*/.package-licenses.generated
packages/*/LICENSE
packages/*/COMMERCIAL_LICENSE.txt

# Editor
.vscode/settings.json
.idea/
*.swp
*.swo

# AI assistant workspace: local settings and local state stay out of the project,
# the shared context-management files are tracked.
.claude/*
!.claude/README.md
!.claude/codebase-map.md
!.claude/tasks/
.claude/state/
__pycache__/

# Archify local generator toolchain and build receipts
.archify/
docs/public/architecture/*.finalize*.json
docs/public/architecture/*.browser-check.json
docs/public/architecture/*.delivery.json

