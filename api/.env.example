# Database engine: libsql (default) or postgres
DB_ENGINE=libsql

# ── libSQL (SQLite) ──────────────────────────────────────────────────────────
DATABASE_URL=file:src/persistence/local.db
# AUTH_TOKEN=           # Auth token for remote libSQL databases (e.g. Turso)
# SQLITE_TENANTS=       # Comma-separated tenant names (e.g. tenant_a,tenant_b)
# SQLITE_DATABASE_TEMPLATE=libsql://my-{tenant}.turso.io # Required for multiple remote tenants

# ── PostgreSQL (when DB_ENGINE=postgres) ─────────────────────────────────────
# DATABASE_HOST=127.0.0.1
# DATABASE_PORT=5432
# DATABASE_NAME=nestjs_pipeline
# DATABASE_USER=postgres
# DATABASE_PASSWORD=postgres
# DB_DEFAULT_SCHEMA=tenant
# TENANT_SCHEMAS=       # Comma-separated schemas for multi-tenant migrations

# ── Auth ─────────────────────────────────────────────────────────────────────
AUTH_LOGIN_CODE=secret-code
JWT_SECRET=change-me-in-production
# JWT_ISSUER=
# JWT_AUDIENCE=
# JWT_ALGORITHMS=HS256
# JWT_PUBLIC_KEY=
# API_CLIENTS=          # JSON array of allowed API client configs

# ── Fastify adapter (set ADAPTER=fastify to use) ────────────────────────────
# ADAPTER=fastify
# SESSION_SECRET=       # 32-byte hex string for @fastify/secure-session

# ── BullMQ / Redis ──────────────────────────────────────────────────────────
# REDIS_HOST=localhost
# REDIS_PORT=6379

# ── OpenTelemetry ────────────────────────────────────────────────────────────
# OTEL_SERVICE_NAME=users-api
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
