{
  "name": "@nestjs-pipeline/ddd-api",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "description": "Sample NestJS app demonstrating @nestjs-pipeline/core usage",
  "scripts": {
    "start": "pnpm build && node dist/main",
    "start:fastify": "pnpm build && ADAPTER=fastify node dist/main",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "pnpm build && { trap 'kill 0' EXIT; tsc -p tsconfig.build.json --watch --preserveWatchOutput & tsc-alias -p tsconfig.build.json --watch & node --watch dist/main; }",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "rebuild": "pnpm run clean && pnpm run build",
    "db:migrate": "tsx src/persistence/cli.ts migrate",
    "db:revert": "tsx src/persistence/cli.ts revert",
    "permissions:rebuild": "tsx src/persistence/cli.ts permissions:rebuild",
    "permissions:verify": "tsx src/persistence/cli.ts permissions:verify",
    "sessions:purge": "tsx src/persistence/cli.ts sessions:purge",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.config.e2e.ts",
    "test:e2e:watch": "vitest --config vitest.config.e2e.ts",
    "start:prod": "node dist/main",
    "start:prod:fastify": "ADAPTER=fastify node dist/main"
  },
  "dependencies": {
    "@casl/ability": "^7.0.1",
    "@cqrs-ddd/core": "workspace:*",
    "@cqrs-ddd/mikro-orm": "workspace:*",
    "@cqrs-ddd/safe-stringify": "workspace:*",
    "@fastify/secure-session": "^8.4.0",
    "@keyv/redis": "^5.1.6",
    "@mikro-orm/core": "^7.2.1",
    "@mikro-orm/libsql": "^7.2.1",
    "@mikro-orm/migrations": "^7.2.1",
    "@mikro-orm/postgresql": "^7.2.1",
    "@mikro-orm/sql": "^7.2.1",
    "@nestjs-pipeline/audit": "workspace:*",
    "@nestjs-pipeline/cache": "workspace:*",
    "@nestjs-pipeline/casl": "workspace:*",
    "@nestjs-pipeline/core": "workspace:*",
    "@nestjs-pipeline/correlation": "workspace:*",
    "@nestjs-pipeline/deadletter": "workspace:*",
    "@nestjs-pipeline/feature-flags": "workspace:*",
    "@nestjs-pipeline/idempotency": "workspace:*",
    "@nestjs-pipeline/job-context": "workspace:*",
    "@nestjs-pipeline/opentelemetry": "workspace:*",
    "@nestjs-pipeline/rate-limit": "workspace:*",
    "@nestjs-pipeline/resilience": "workspace:*",
    "@nestjs-pipeline/tenant": "workspace:*",
    "@nestjs-pipeline/zod": "workspace:*",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.1.1",
    "@nestjs/core": "^12.1.1",
    "@nestjs/cqrs": "^12.1.0",
    "@nestjs/platform-express": "^12.1.1",
    "@nestjs/platform-fastify": "^12.1.1",
    "@openfeature/server-sdk": "^1.23.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/core": "^2.11.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.222.0",
    "@opentelemetry/instrumentation-http": "^0.222.0",
    "@opentelemetry/instrumentation-pg": "^0.74.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "bullmq": "^5.81.5",
    "cache-manager": "^7.2.9",
    "cockatiel": "^4.0.0",
    "cookie-parser": "^1.4.7",
    "jose": "^6.2.12",
    "keyv": "^5.6.0",
    "nestjs-pino": "^5.2.1",
    "pg": "^8.23.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "rate-limiter-flexible": "^11.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@cqrs-ddd/uuidv7": "workspace:*",
    "@libsql/client": "^0.18.0",
    "@nestjs/testing": "^12.1.1",
    "@redis/client": "^6.2.1",
    "@testcontainers/redis": "^12.2.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.2",
    "supertest": "^7.3.0",
    "testcontainers": "^12.2.0",
    "tsc-alias": "^1.9.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.2"
  }
}
