{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "outDir": "dist",
    "rootDir": "src",
    "paths": {
      "@auths/*": ["./src/auths/*"],
      "@roles/*": ["./src/roles/*"],
      "@users/*": ["./src/users/*"],
      "@common/*": ["./src/common/*"],
      "@persistence/*": ["./src/persistence/*"],
      "@test/*": ["./test/*"]
    }
  },
  "include": ["src"],
  "exclude": ["dist", "node_modules"]
}
