{
  "$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
  "files": {
    "includes": [
      "**",
      "!!**/dist",
      "!!**/coverage",
      "!!**/.turbo",
      "!!**/.snapshot-*.json",
      "!!**/*.db"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noStaticOnlyClass": "off"
      },
      "style": {
        "useImportType": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    },
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    }
  },
  "overrides": [
    {
      "includes": [
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "**/*.integration.spec.ts",
        "**/*.test.ts",
        "**/*.test.tsx"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off",
            "noTemplateCurlyInString": "off"
          },
          "style": {
            "noNonNullAssertion": "off"
          }
        }
      }
    },
    {
      "includes": ["**/outcomes/**", "**/events/**"],
      "linter": {
        "rules": {
          "complexity": {
            "noUselessConstructor": "off"
          }
        }
      }
    },
    {
      "includes": ["**/migrations/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noTemplateCurlyInString": "off"
          }
        }
      }
    }
  ],
  "plugins": [
    {
      "path": "./biome/plugins/persistence-lifecycle.grit",
      "includes": [
        "**/persistence/**/*.ts",
        "**/persistence/*.ts",
        "!**/*.spec.ts",
        "!**/*.test.ts"
      ]
    },
    {
      "path": "./biome/plugins/test-suite.grit",
      "includes": ["**/*.spec.ts", "**/*.test.ts"]
    },
    {
      "path": "./biome/plugins/verify-package-licenses.grit",
      "includes": ["**/packages/**/*.ts"]
    },
    {
      "path": "./biome/plugins/package-licenses.grit",
      "includes": ["**/packages/**/*.ts"]
    }
  ]
}
