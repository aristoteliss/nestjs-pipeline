engine biome(1.0)
language js(typescript)

// Matches receiver/property names, not TypeScript types or aliases.
// Domain, persistence and test files are excluded in biome.json.
or {
  JsAssignmentExpression(left=$target),
  JsPreUpdateExpression(operand=$target),
  JsPostUpdateExpression(operand=$target)
} as $mutation where {
  $target <: or {
    JsStaticMemberAssignment(object=$aggregate, member=$property),
    JsComputedMemberAssignment(object=$aggregate, member=$property)
  },
  $aggregate <: r"^(?:user|role|aggregate|entity)$",
  $property <: r"^[\"']?(?:id|createdAt|updatedAt|version|username|department|name)[\"']?$",
  register_diagnostic(span=$mutation, message="Do not assign aggregate properties directly. Use domain methods or factories. For a DTO, use a DTO-specific receiver name.", severity="error")
}
