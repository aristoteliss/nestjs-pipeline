engine biome(1.0)
language js(typescript)

// `@cqrs-ddd/core` exposes three entry points — `/domain`,
// `/application` and `/persistence` — so the layering is expressed by the import
// itself rather than only by convention.
//
// Domain and CQRS code may not reach the persistence entry point. It is the only
// one that touches MikroORM, and a handler that imports from it has taken a
// dependency on the adapter instead of the port. Repository contracts
// (`ICommandRepository`, `IQueryRepository`, `IWriteSideAggregateRepository`) are
// exported from `/application` precisely so handlers never need to.
//
// Scoped to domain, CQRS and application code in biome.json.

JsImportNamedClause(source=$source) as $clause where {
  $source <: r".*@cqrs-ddd/core/persistence.*",
  register_diagnostic(span=$clause, message="Domain and CQRS code must not import @cqrs-ddd/core/persistence. That entry point holds the MikroORM adapters; depend on the repository ports exported from @cqrs-ddd/core/application instead.", severity="error")
}
