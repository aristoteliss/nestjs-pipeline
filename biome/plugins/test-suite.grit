engine biome(1.0)
language js(typescript)

JsCallExpression(callee=$callee) as $call where {
  $callee <: or {
    `describe.only`,
    `it.only`,
    `test.only`,
    `fit`,
    `fdescribe`
  },
  register_diagnostic(span=$call, message="Do not commit focused tests (.only / fit / fdescribe); the test suite must execute all tests.", severity="error")
}
