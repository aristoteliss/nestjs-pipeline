engine biome(1.0)
language js(typescript)

JsImportNamedClause(source=$source) as $clause where {
  $source <: r".*(?:\.\./\.\./api/|@nestjs-pipeline/ddd-|@cqrs-ddd/core).*",
  register_diagnostic(span=$clause, message="Standalone pipeline packages cannot depend on the api application, the private DDD workspaces or @cqrs-ddd/core; preserve standalone package license boundaries.", severity="error")
}
