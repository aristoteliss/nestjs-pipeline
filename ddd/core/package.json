{
  "name": "@nestjs-pipeline/ddd-core",
  "version": "0.0.3",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "description": "Nest-oriented DDD support for the sample applications: domain primitives, application ports and MikroORM persistence adapters, exported as separate entry points.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "rebuild": "pnpm run clean && pnpm run build",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@nestjs-pipeline/core": "workspace:*",
    "@nestjs-pipeline/correlation": "workspace:*",
    "@nestjs/common": "^11.2.1",
    "@nestjs/cqrs": "^11.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@mikro-orm/core": "^7.1.13",
    "@vitest/coverage-v8": "^4.1.11",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./domain": {
      "types": "./dist/domain/index.d.ts",
      "default": "./dist/domain/index.js"
    },
    "./application": {
      "types": "./dist/application/index.d.ts",
      "default": "./dist/application/index.js"
    },
    "./persistence": {
      "types": "./dist/persistence/index.d.ts",
      "default": "./dist/persistence/index.js"
    }
  },
  "peerDependencies": {
    "@mikro-orm/core": "^7.1.13"
  },
  "peerDependenciesMeta": {
    "@mikro-orm/core": {
      "optional": true
    }
  }
}
