{
  "name": "@nestjs-pipeline/ddd-users-api",
  "version": "0.0.4",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "description": "Sample NestJS app demonstrating @nestjs-pipeline/core usage",
  "scripts": {
    "start": "ts-node -r tsconfig-paths/register src/main.ts",
    "start:fastify": "ADAPTER=fastify ts-node -r tsconfig-paths/register src/main.ts",
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "dev": "node --watch -r ts-node/register -r tsconfig-paths/register src/main.ts",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "rebuild": "pnpm run clean && pnpm run build",
    "db:migrate": "tsx src/persistence/migrate.ts",
    "db:revert": "tsx src/persistence/revert.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.config.e2e.ts",
    "test:e2e:watch": "vitest --config vitest.config.e2e.ts",
    "start:prod": "node dist/main",
    "start:prod:fastify": "ADAPTER=fastify node dist/main"
  },
  "dependencies": {
    "@casl/ability": "^7.0.0",
    "@fastify/secure-session": "^8.3.0",
    "@keyv/redis": "^5.0.0",
    "@libsql/client": "^0.17.3",
    "@mikro-orm/core": "^7.1.13",
    "@mikro-orm/libsql": "^7.1.13",
    "@mikro-orm/migrations": "^7.1.13",
    "@mikro-orm/nestjs": "^7.0.2",
    "@mikro-orm/postgresql": "^7.1.13",
    "@mikro-orm/sqlite": "^7.1.13",
    "@nestjs-pipeline/audit": "workspace:*",
    "@nestjs-pipeline/cache": "workspace:*",
    "@nestjs-pipeline/casl": "workspace:*",
    "@nestjs-pipeline/core": "workspace:*",
    "@nestjs-pipeline/correlation": "workspace:*",
    "@nestjs-pipeline/ddd-core": "workspace:*",
    "@nestjs-pipeline/deadletter": "workspace:*",
    "@nestjs-pipeline/feature-flags": "workspace:*",
    "@nestjs-pipeline/idempotency": "workspace:*",
    "@nestjs-pipeline/opentelemetry": "workspace:*",
    "@nestjs-pipeline/rate-limit": "workspace:*",
    "@nestjs-pipeline/resilience": "workspace:*",
    "@nestjs-pipeline/zod": "workspace:*",
    "@nestjs/bullmq": "^11.0.5",
    "@nestjs/common": "^11.2.1",
    "@nestjs/core": "^11.2.1",
    "@nestjs/cqrs": "^11.0.3",
    "@nestjs/platform-express": "^11.2.1",
    "@nestjs/platform-fastify": "^11.2.1",
    "@openfeature/server-sdk": "^1.13.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.221.0",
    "@opentelemetry/instrumentation-http": "^0.221.0",
    "@opentelemetry/instrumentation-nestjs-core": "^0.67.0",
    "@opentelemetry/instrumentation-pg": "^0.73.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "bullmq": "^5.77.6",
    "cache-manager": "^7.2.8",
    "cockatiel": "^3.2.1",
    "jose": "^6.2.10",
    "keyv": "^5.5.3",
    "nestjs-pino": "^4.6.1",
    "pg": "^8.23.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "rate-limiter-flexible": "^5.0.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@nestjs/testing": "^11.2.1",
    "@testcontainers/redis": "^11.14.0",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.11",
    "supertest": "^7.2.2",
    "testcontainers": "^11.14.0",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "unplugin-swc": "^1.5.9",
    "vitest": "^4.1.11"
  }
}
