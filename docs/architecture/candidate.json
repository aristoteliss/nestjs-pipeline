  "cards": [
    {
      "dot": "emerald",
      "title": "Presentation Layer (API & Ingress)",
      "items": [
        "Snapshot compiled: 2026-10-03 13:15:00 UTC @ git commit e9a360e",
        "TenantSchemaMiddleware extracts multi-tenant context, setting up TenantSchemaContext for PostgreSQL search path or libSQL per-tenant isolation",
        "AuthSessionGuard runs RequestPrincipalResolver to validate sessions, setting req.sessionPrincipal and caller identity",
        "StandardSchemaValidationPipe validates CreateUserDto with Zod, returning structured 400 zodBadRequest on validation failure",
        "UsersController maps validated DTO into CreateUserCommand and dispatches via commandBus.execute(cmd)"
      ]
    },
    {
      "dot": "rose",
      "title": "Pipeline Interceptor Layer (Cross-Cutting Onion)",
      "items": [
        "PipelineRunner binds PipelineContext in AsyncLocalStorage (pipelineStore), seeding tenantId and correlationId before entering behaviors",
        "LoggingBehavior measures duration and sanitizes payloads using @cqrs-ddd/safe-stringify with configurable redaction",
        "CaslBehavior checks type-level abilities (requires({ action: 'create', subject: 'User' })), failing closed with UnauthorizedActionException",
        "IdempotencyBehavior claims Redis operation key; replay verifies requireAbilityDigest to prevent privilege escalation"
      ]
    },
    {
      "dot": "cyan",
      "title": "Application & Domain Layers (CQRS & DDD Core)",
      "items": [
        "CommandBaseHandler.execute() provides a framework-neutral execution template around abstract handle(cmd)",
        "CreateUserHandler.handle() instantiates User.create(), checks post-mutation CASL field authorization, and calls repository.save(user)",
        "User aggregate inherits from RootEntity, enforcing username and department domain rules with private setters for MikroORM hydration",
        "User.create() records UserCreatedEvent in the aggregate's uncommitted event buffer; version starts at 0"
      ]
    },
    {
      "dot": "amber",
      "title": "Persistence & Reliability Infrastructure Layers",
      "items": [
        "@PersistedWrite enforces lifecycle order: @Cache -> @AcknowledgePersisted -> @MapPersistenceErrors",
        "CreateUserCommandRepository asserts autocommit and flushes the entity within the tenant's isolated EntityManager",
        "user.acknowledgePersisted() advances version baseline only after durable database commit succeeds",
        "CommandBaseHandler publishes uncommitted events via EventBus.publishAll(); UserCreatedHandler enqueues welcome email into BullMQ"
      ]
    }
  ]
}
