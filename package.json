{
  "name": "nestjs-pipeline-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "NestJS CQRS pipeline behavior monorepo",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm test:unit",
    "test:unit": "pnpm lint:persistence && pnpm -r --no-bail test",
    "test:coverage": "pnpm -r --no-bail --workspace-concurrency=1 run test --coverage --coverage.reporter=text-summary --coverage.reporter=json-summary",
    "test:build": "pnpm -r --no-bail build",
    "test:e2e": "pnpm --filter @nestjs-pipeline/ddd-users-api test:e2e",
    "lint": "pnpm lint:persistence && pnpm -r lint",
    "clean": "pnpm -r run clean",
    "rebuild": "pnpm -r run clean && pnpm -r build",
    "test:release": "pnpm rebuild && pnpm copy-licenses && node integration/packages/release.mjs",
    "verify:all": "pnpm lint && pnpm test:unit && pnpm test:build && pnpm test:release && pnpm test:e2e",
    "copy-licenses": "node -e \"const fs=require('fs'),path=require('path'),dirs=fs.readdirSync('packages').filter(d=>fs.existsSync(path.join('packages',d,'package.json')));for(const d of dirs){fs.copyFileSync('LICENSE',path.join('packages',d,'LICENSE'));fs.copyFileSync('COMMERCIAL_LICENSE.txt',path.join('packages',d,'COMMERCIAL_LICENSE.txt'));}\"",
    "publish:all": "pnpm copy-licenses && pnpm -r publish --access public",
    "check": "biome check .",
    "format": "biome check --write .",
    "lint:persistence": "biome lint --only=plugin ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@types/node": "^26.2.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "overrides": {
    "@nestjs/core": "11.2.1",
    "@nestjs/common": "11.2.1",
    "@nestjs/cqrs": "11.0.3"
  }
}
