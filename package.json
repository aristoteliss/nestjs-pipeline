{
  "name": "nestjs-pipeline-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "NestJS CQRS pipeline behavior monorepo",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm test:unit",
    "test:unit": "pnpm lint:persistence && pnpm -r --no-bail test",
    "test:build": "pnpm -r --no-bail build",
    "test:e2e": "pnpm --filter @nestjs-pipeline/ddd-users-api test:e2e",
    "lint": "pnpm lint:persistence && pnpm -r lint",
    "clean": "pnpm -r clean",
    "rebuild": "pnpm -r clean && pnpm -r build",
    "publish:all": "pnpm -r publish --access public",
    "check": "biome check .",
    "format": "biome check --write .",
    "lint:persistence": "biome lint --only=plugin ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@types/node": "^26.2.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "overrides": {
    "@nestjs/core": "11.2.1",
    "@nestjs/common": "11.2.1",
    "@nestjs/cqrs": "11.0.3"
  }
}
