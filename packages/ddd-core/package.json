{
  "name": "@cqrs-ddd/core",
  "version": "0.2.0",
  "description": "Framework-neutral DDD building blocks for TypeScript: aggregates and domain events, CQRS base classes and repository ports, revision-fenced caching and MikroORM persistence adapters, as separate entry points.",
  "author": "Aristotelis",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aristoteliss/nestjs-pipeline.git",
    "directory": "packages/ddd-core"
  },
  "homepage": "https://github.com/aristoteliss/nestjs-pipeline/tree/master/packages/ddd-core#readme",
  "bugs": {
    "url": "https://github.com/aristoteliss/nestjs-pipeline/issues"
  },
  "keywords": [
    "ddd",
    "domain-driven-design",
    "cqrs",
    "aggregate",
    "domain-events",
    "repository",
    "mikro-orm",
    "cache"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./domain": {
      "types": "./dist/domain/index.d.ts",
      "default": "./dist/domain/index.js"
    },
    "./application": {
      "types": "./dist/application/index.d.ts",
      "default": "./dist/application/index.js"
    },
    "./persistence": {
      "types": "./dist/persistence/index.d.ts",
      "default": "./dist/persistence/index.js"
    },
    "./http": {
      "types": "./dist/http/index.d.ts",
      "default": "./dist/http/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "COMMERCIAL_LICENSE.txt"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "rebuild": "pnpm run clean && pnpm run build",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm run rebuild"
  },
  "dependencies": {
    "@cqrs-ddd/safe-stringify": "workspace:^",
    "@cqrs-ddd/uuidv7": "workspace:^"
  },
  "peerDependencies": {
    "@mikro-orm/core": "^7.1.13"
  },
  "peerDependenciesMeta": {
    "@mikro-orm/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@mikro-orm/core": "^7.1.13",
    "@vitest/coverage-v8": "^4.1.11",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
