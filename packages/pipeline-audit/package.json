{
  "name": "@nestjs-pipeline/audit",
  "version": "0.1.0",
  "description": "Audit-trail behavior for the NestJS pipeline — records who did what (with outcome, duration, and redacted payload) to a pluggable sink (console by default, Postgres drop-in, or your own AuditSink).",
  "author": "Aristotelis <aristotelis@ik.me>",
  "license": "SEE LICENSE IN LICENSE",
  "keywords": [
    "nestjs",
    "pipeline",
    "cqrs",
    "audit",
    "audit-trail",
    "audit-log",
    "compliance",
    "security",
    "redaction",
    "behavior"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aristoteliss/nestjs-pipeline.git",
    "directory": "packages/pipeline-audit"
  },
  "homepage": "https://github.com/aristoteliss/nestjs-pipeline#readme",
  "bugs": {
    "url": "https://github.com/aristoteliss/nestjs-pipeline/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "COMMERCIAL_LICENSE.txt"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "rebuild": "pnpm run clean && pnpm run build",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm run rebuild"
  },
  "peerDependencies": {
    "@nestjs-pipeline/core": "*",
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "reflect-metadata": "^0.1.13 || ^0.2.0"
  },
  "devDependencies": {
    "@nestjs/common": "^11.2.1",
    "@vitest/coverage-v8": "^4.1.7",
    "reflect-metadata": "^0.2.2",
    "vitest": "^4.1.7"
  }
}
