{
  "name": "@nestjs-pipeline/feature-flags",
  "version": "0.1.0",
  "description": "Feature-flag gating behavior for the NestJS pipeline — provider-agnostic via OpenFeature (Unleash, Flagsmith, LaunchDarkly, …).",
  "author": "Aristotelis <aristotelis@ik.me>",
  "license": "SEE LICENSE IN LICENSE",
  "keywords": [
    "nestjs",
    "pipeline",
    "cqrs",
    "feature-flags",
    "feature-toggles",
    "openfeature",
    "unleash",
    "flagsmith",
    "behavior"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aristoteliss/nestjs-pipeline.git",
    "directory": "packages/pipeline-feature-flags"
  },
  "homepage": "https://github.com/aristoteliss/nestjs-pipeline#readme",
  "bugs": {
    "url": "https://github.com/aristoteliss/nestjs-pipeline/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "COMMERCIAL_LICENSE.txt"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "rebuild": "pnpm run clean && pnpm run build",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "node ../../scripts/package-licenses.mjs prepare",
    "postpack": "node ../../scripts/package-licenses.mjs cleanup",
    "prepublishOnly": "pnpm run rebuild"
  },
  "peerDependencies": {
    "@nestjs-pipeline/core": "*",
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "@openfeature/server-sdk": "^1.13.0",
    "reflect-metadata": "^0.1.13 || ^0.2.0"
  },
  "devDependencies": {
    "@nestjs/common": "^11.2.1",
    "@openfeature/server-sdk": "^1.13.0",
    "@vitest/coverage-v8": "^4.1.11",
    "reflect-metadata": "^0.2.2",
    "vitest": "^4.1.11"
  }
}
