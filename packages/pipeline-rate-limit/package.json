{
  "name": "@nestjs-pipeline/rate-limit",
  "version": "0.4.3",
  "description": "Rate-limiting behavior for the NestJS pipeline \u2014 backend-agnostic, powered by rate-limiter-flexible (memory, Redis/Valkey, Mongo, SQL drop-ins).",
  "author": "Aristotelis <aristotelis@ik.me>",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "nestjs",
    "pipeline",
    "cqrs",
    "rate-limit",
    "rate-limiter",
    "throttle",
    "rate-limiter-flexible",
    "redis",
    "ddos",
    "behavior"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aristoteliss/nestjs-pipeline.git",
    "directory": "packages/pipeline-rate-limit"
  },
  "homepage": "https://aristoteliss.github.io/nestjs-pipeline/packages/nestjs-pipeline/rate-limit/",
  "bugs": {
    "url": "https://github.com/aristoteliss/nestjs-pipeline/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "COMMERCIAL_LICENSE.txt"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "rebuild": "pnpm run clean && pnpm run build",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm run rebuild"
  },
  "peerDependencies": {
    "@nestjs-pipeline/core": "workspace:^",
    "@nestjs/common": "^12.1.0",
    "@nestjs/core": "^12.1.0",
    "reflect-metadata": "^0.1.13 || ^0.2.0"
  },
  "devDependencies": {
    "@nestjs-pipeline/core": "workspace:*",
    "@nestjs/common": "^12.1.1",
    "@nestjs/core": "^12.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "rate-limiter-flexible": "^11.2.1",
    "reflect-metadata": "^0.2.2",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@cqrs-ddd/safe-stringify": "workspace:^"
  }
}
