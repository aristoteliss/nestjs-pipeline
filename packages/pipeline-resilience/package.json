{
  "name": "@nestjs-pipeline/resilience",
  "version": "0.2.0",
  "description": "Resilience for @nestjs-pipeline/core, powered by cockatiel — named policies shared by outbound adapters (retry, circuit breaker, timeout, bulkhead, fallback) and a behavior for handler-level retry, timeout and bulkhead.",
  "author": "Aristotelis <aristotelis@ik.me>",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "nestjs",
    "cqrs",
    "pipeline",
    "resilience",
    "fault-tolerance",
    "retry",
    "circuit-breaker",
    "timeout",
    "bulkhead",
    "fallback",
    "cockatiel"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aristoteliss/nestjs-pipeline.git",
    "directory": "packages/pipeline-resilience"
  },
  "homepage": "https://github.com/aristoteliss/nestjs-pipeline#readme",
  "bugs": {
    "url": "https://github.com/aristoteliss/nestjs-pipeline/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "COMMERCIAL_LICENSE.txt"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "rebuild": "pnpm run clean && pnpm run build",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm run rebuild"
  },
  "peerDependencies": {
    "@nestjs-pipeline/core": "workspace:^",
    "@nestjs/common": "^11.0.0",
    "cockatiel": "^3.2.1",
    "reflect-metadata": "^0.1.13 || ^0.2.0"
  },
  "devDependencies": {
    "@nestjs-pipeline/core": "workspace:*",
    "@nestjs/common": "^11.2.1",
    "@vitest/coverage-v8": "^4.1.11",
    "cockatiel": "^3.2.1",
    "reflect-metadata": "^0.2.2",
    "vitest": "^4.1.11"
  }
}
