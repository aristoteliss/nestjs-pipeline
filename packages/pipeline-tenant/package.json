{
  "name": "@nestjs-pipeline/tenant",
  "version": "0.4.0",
  "description": "The current tenant for @nestjs-pipeline/core applications: the running pipeline's tenant, or the tenant of a runWithTenant scope",
  "author": "Aristotelis",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aristoteliss/nestjs-pipeline.git",
    "directory": "packages/pipeline-tenant"
  },
  "homepage": "https://github.com/aristoteliss/nestjs-pipeline/tree/master/packages/pipeline-tenant#readme",
  "bugs": {
    "url": "https://github.com/aristoteliss/nestjs-pipeline/issues"
  },
  "keywords": [
    "nestjs",
    "cqrs",
    "pipeline",
    "multi-tenancy",
    "tenant",
    "asynclocalstorage"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "COMMERCIAL_LICENSE.txt"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "rebuild": "pnpm run clean && pnpm run build",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm run rebuild"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.2",
    "reflect-metadata": "^0.2.2",
    "vitest": "^5.0.2"
  }
}
