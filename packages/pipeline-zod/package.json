{
  "name": "@nestjs-pipeline/zod",
  "version": "0.1.7",
  "description": "Zod validation/parsing behavior for @nestjs-pipeline/core that applies successful parsed object output to the existing request",
  "author": "Aristotelis <aristotelis@ik.me>",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aristoteliss/nestjs-pipeline.git",
    "directory": "packages/pipeline-zod"
  },
  "homepage": "https://github.com/aristoteliss/nestjs-pipeline#readme",
  "bugs": {
    "url": "https://github.com/aristoteliss/nestjs-pipeline/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "COMMERCIAL_LICENSE.txt"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "rebuild": "pnpm run clean && pnpm run build",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "node ../../scripts/package-licenses.mjs prepare",
    "postpack": "node ../../scripts/package-licenses.mjs cleanup",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "@nestjs-pipeline/core": "*",
    "@nestjs/common": ">=10",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@nestjs-pipeline/core": "workspace:*",
    "@nestjs/common": "^11.2.1",
    "reflect-metadata": "^0.2.2",
    "vitest": "^4.1.11",
    "zod": "^4.4.3"
  }
}
