{
  "name": "@nestjs-pipeline/zod",
  "version": "0.4.3",
  "description": "Zod validation/parsing behavior for @nestjs-pipeline/core that applies successful parsed object output to the existing request",
  "author": "Aristotelis <aristotelis@ik.me>",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aristoteliss/nestjs-pipeline.git",
    "directory": "packages/pipeline-zod"
  },
  "homepage": "https://aristoteliss.github.io/nestjs-pipeline/packages/nestjs-pipeline/zod/",
  "bugs": {
    "url": "https://github.com/aristoteliss/nestjs-pipeline/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "COMMERCIAL_LICENSE.txt"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "rebuild": "pnpm run clean && pnpm run build",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm run rebuild",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@nestjs-pipeline/core": "workspace:^",
    "@nestjs/common": "^12.1.0",
    "@nestjs/core": "^12.1.0",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@nestjs-pipeline/core": "workspace:*",
    "@nestjs/common": "^12.1.1",
    "@nestjs/core": "^12.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "reflect-metadata": "^0.2.2",
    "vitest": "^5.0.2",
    "zod": "^4.6.5"
  },
  "dependencies": {
    "@cqrs-ddd/untyped": "workspace:^"
  }
}
