{
  "name": "@nestjs-pipeline/core",
  "version": "0.6.1",
  "description": "NestJS CQRS pipeline behaviors under the @nestjs-pipeline name: re-exports @cqrs-ddd/pipeline and @cqrs-ddd/nestjs, which hold the code",
  "author": "Aristotelis <aristotelis@ik.me>",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aristoteliss/nestjs-pipeline.git",
    "directory": "packages/pipeline"
  },
  "homepage": "https://aristoteliss.github.io/ddd-cqrs/packages/pipeline/",
  "bugs": {
    "url": "https://github.com/aristoteliss/ddd-cqrs/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "COMMERCIAL_LICENSE.txt"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "rebuild": "pnpm run clean && pnpm run build",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm run rebuild"
  },
  "dependencies": {
    "@cqrs-ddd/nestjs": "^0.6.1"
  },
  "devDependencies": {
    "@cqrs-ddd/core": "^0.6.1",
    "@cqrs-ddd/pipeline": "^0.6.1",
    "@nestjs/common": "^12.5.1",
    "@nestjs/core": "^12.5.1",
    "@nestjs/cqrs": "^12.1.3",
    "@vitest/coverage-v8": "^5.1.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "vitest": "^5.1.1"
  },
  "peerDependencies": {
    "@cqrs-ddd/core": "^0.6.1",
    "@cqrs-ddd/pipeline": "^0.6.1",
    "@nestjs/common": "^12.1.1",
    "@nestjs/core": "^12.1.1",
    "@nestjs/cqrs": "^12.1.0"
  }
}
